# Copied to .env by create-cen-app. Variables are validated in backend/src/env.ts — the
# server refuses to start if one is missing or malformed. (The container settings below are
# exceptions: only the development tooling reads them.)

# Container engine for local services: auto, docker, or podman.
CEN_CONTAINER_ENGINE=auto

# If 5432 is taken on your machine, change DB_PORT and the port in DATABASE_URL together.
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Any random string >= 32 chars. Generate a real one for production: `openssl rand -hex 32`
BETTER_AUTH_SECRET=dev-only-secret-change-me-please-really
BETTER_AUTH_URL=http://localhost:3000

# Dev API port. In production, PaaS platforms inject PORT instead.
API_PORT=3000

# Vite dev server port.
WEB_PORT=5173

# Optional machine access for routes behind apiKeyRouter() (agents, other backends).
# >= 32 characters; while unset, those routes answer 401. Generate: openssl rand -hex 32
# API_KEY=
