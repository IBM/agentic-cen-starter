# Copy to .env.production and set these values for the deployed environment.

# PostgreSQL connection string reachable from the runtime platform.
# IBM Cloud Databases serves certificates from its own private CA ("CN=IBM Cloud Databases"),
# so node-postgres cannot verify them against the public trust store. Keep sslmode=verify-full
# and fill in DATABASE_CA_CERT below; the deploy scripts refuse to continue if you do neither.
DATABASE_URL=postgres://USER:PASSWORD@HOST:32000/ibmclouddb?sslmode=verify-full

# CA certificate for the database, as base64 or as PEM with literal \n between lines.
# For IBM Cloud Databases:
#   ibmcloud cdb deployment-cacert <deployment-name> > icd-ca.pem
#   base64 -i icd-ca.pem | tr -d '\n'
# Leave empty only if DATABASE_URL uses sslmode=no-verify, which encrypts the connection but
# does not authenticate the server. That is a demo-grade shortcut, not a default.
DATABASE_CA_CERT=

# Generate a real secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Public origin of the deployed app, without a trailing slash. Deploy scripts derive it
# automatically when left on this example value.
BETTER_AUTH_URL=https://cen-starter.example.com

# Migrations auto-apply at boot in production. Set to "false" to manage them manually.
# MIGRATE_ON_START=false

# Optional deployment credential. Prefer exporting IBMCLOUD_API_KEY only for the deploy command.
# Never paste a key into chat. An agent may offer to create a dedicated key, but must ask first
# and store it without displaying it. This value is filtered out of the application secret.
# IAM_API_KEY=
